{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"$CLAUDE_PROJECT_DIR/backend\" --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_python.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run black *)",
      "Bash(uv run alembic upgrade *)",
      "Bash(uv run alembic revision *)",
      "Bash(uv run alembic current *)",
      "Bash(uv run alembic history *)",
      "Bash(uv sync *)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run test *)",
      "Bash(npm test *)",
      "Bash(npm run build *)",
      "Bash(npm run gen:api *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose up *)",
      "Bash(docker compose build *)",
      "Bash(docker compose -f docker-compose.dev.yml up *)",
      "Bash(docker compose -f docker-compose.dev.yml ps *)",
      "Bash(docker compose -f docker-compose.dev.yml logs *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git show *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "PowerShell(uv run pytest *)",
      "PowerShell(uv run ruff *)",
      "PowerShell(uv run black *)",
      "PowerShell(uv run alembic upgrade *)",
      "PowerShell(uv run alembic revision *)",
      "PowerShell(uv run alembic current *)",
      "PowerShell(uv sync *)",
      "PowerShell(npm run lint *)",
      "PowerShell(npm run typecheck *)",
      "PowerShell(npm run test *)",
      "PowerShell(npm test *)",
      "PowerShell(npm run build *)",
      "PowerShell(npm run gen:api *)",
      "PowerShell(docker compose ps *)",
      "PowerShell(docker compose logs *)",
      "PowerShell(docker compose up *)",
      "PowerShell(docker compose build *)",
      "PowerShell(docker compose -f docker-compose.dev.yml up *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git branch *)",
      "PowerShell(git switch *)",
      "PowerShell(git show *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(gh run view *)",
      "PowerShell(gh run list *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(uv add *)",
      "Bash(npm install *)",
      "Bash(npx *)",
      "Bash(uv run alembic downgrade *)",
      "Bash(docker compose down *)",
      "Bash(docker volume *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git merge *)",
      "PowerShell(git rebase *)",
      "PowerShell(uv add *)",
      "PowerShell(npm install *)",
      "PowerShell(npx *)",
      "PowerShell(uv run alembic downgrade *)",
      "PowerShell(docker compose down *)",
      "PowerShell(docker volume *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh repo *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Bash(docker compose down -v *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(Remove-Item -Recurse *)",
      "PowerShell(docker compose down -v *)"
    ]
  }
}
