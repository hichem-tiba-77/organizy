# Copy to .env and adjust. .env is gitignored: never commit real values.
# The backend reads this file from the repo root; docker compose reads it too.

# --- PostgreSQL (docker-compose.dev.yml) ---
POSTGRES_USER=organizy
POSTGRES_PASSWORD=organizy
POSTGRES_DB=organizy
POSTGRES_PORT=5432

# --- Backend ---
# SQLAlchemy URL, psycopg 3 driver. Use 127.0.0.1, not localhost: on Windows
# localhost tries IPv6 ::1 first and stalls ~40s+ before falling back to IPv4.
DATABASE_URL=postgresql+psycopg://organizy:organizy@127.0.0.1:5432/organizy
# Used by pytest only (created by docker/postgres/init).
TEST_DATABASE_URL=postgresql+psycopg://organizy:organizy@127.0.0.1:5432/organizy_test

# IANA time zone used for "today", overdue, nudges and birthdays.
TZ=Africa/Algiers
